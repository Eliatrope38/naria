
POSTGRES_USER=naria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=naria
DATABASE_URL=postgres://naria:change-me@db:5432/naria?sslmode=disable


# dev = cookies non-Secure (HTTP local) ; prod = cookies Secure (HTTPS obligatoire)
APP_ENV=dev
# Adresse publique de l'instance. Elle sert à composer l'adresse d'envoi donnée
# dans le code d'intégration, et les liens des emails.
BASE_URL=http://localhost:8080
ADDR=:8080

# Clé de chiffrement au repos : soumissions conservées et secrets de double
# authentification. Obligatoire en production, et à ne plus changer ensuite :
# la perdre ou la changer rend les soumissions déjà conservées illisibles.
# Sauvegardez-la séparément de la base. Générer : openssl rand -base64 32
APP_SECRET_KEY=

# --- Point d'entrée public des formulaires ----------------------------------
# Taille maximale d'une soumission, en kilo-octets.
# SUBMISSION_MAX_KB=256
# Taille cumulée maximale des pièces jointes d'une soumission, en méga-octets,
# pour les formulaires qui les acceptent. Les fichiers tiennent en mémoire le
# temps de la requête, plusieurs fois leur taille, et quatre envois au plus sont
# traités en même temps. L'email qui les porte pèse un tiers de plus qu'eux :
# restez sous la limite de votre serveur SMTP. Par Microsoft Graph, un email en
# porte 2 Mo au plus.
# ATTACHMENTS_MAX_MB=10
# Quota de stockage par formulaire, en méga-octets : le poids que ses
# soumissions conservées et leurs pièces jointes peuvent atteindre. Au-delà, le
# formulaire ne conserve plus : les soumissions n'arrivent que par email s'il
# en porte le contenu, et sont refusées sinon, jusqu'à ce que la durée de
# conservation ou une suppression libère de la place. Son propriétaire en est
# alerté par email. Vide ou 0 = sans limite.
# FORM_STORAGE_MAX_MB=500
# Antivirus des pièces jointes : adresse d'un démon ClamAV (clamd), « hôte:port »
# ou chemin d'un socket Unix. Vide = les fichiers ne sont pas analysés. Avec le
# service du compose (profil antivirus) : clamav:3310. Une fois réglé, une
# soumission dont un fichier est reconnu est refusée, et toute soumission avec
# fichiers l'est aussi tant que clamd ne répond pas. La liaison n'est pas
# chiffrée : gardez clamd sur la même machine ou un réseau privé.
# CLAMAV_ADDR=clamav:3310
# Soumissions acceptées par adresse IP (par préfixe /64 en IPv6) et par
# formulaire, par tranche de 10 minutes. L'adresse IP ne sert qu'à ce comptage
# en mémoire.
# SUBMIT_RATE_LIMIT=10

# Reverse proxys crus sur l'adresse des visiteurs (CIDR séparés par des
# virgules). X-Forwarded-For n'est lu que si la connexion vient de l'un d'eux ;
# X-Real-IP et True-Client-IP ne le sont jamais. Sans proxy déclaré, l'adresse
# est celle de la connexion : derrière un proxy, tous les visiteurs auraient la
# sienne et partageraient la même limite de débit. Le compose déclare déjà
# Caddy. Derrière un autre proxy, donnez son adresse, pas une plage : tout ce
# qui s'y trouve choisit l'adresse qu'il annonce. Ce proxy doit écrire lui-même
# X-Forwarded-For (nginx : proxy_set_header X-Forwarded-For
# $proxy_add_x_forwarded_for;). L'exemple est celui d'un proxy installé sur
# l'hôte à la place de Caddy, que l'application voit avec l'adresse de la
# passerelle du compose. La valeur remplace celle du compose : si Caddy reste
# devant l'application, gardez-y son adresse (172.30.250.2/32).
# TRUSTED_PROXY_CIDRS=172.30.250.1/32

# --- Email sortant ----------------------------------------------------------
# Notifications de soumission et liens de réinitialisation de mot de passe.
# EMAIL_PROVIDER nomme le service qui les envoie : smtp (défaut) ou graph
# (Microsoft 365). Un service choisi sans tous ses réglages fait refuser le
# démarrage.
# EMAIL_PROVIDER=smtp

# SMTP. SMTP_HOST vide = envoi désactivé (les formulaires « listés »
# fonctionnent quand même ; ceux en mode « email seul » refusent les
# soumissions). SMTP_HOST défini demande SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=formulaires@exemple.fr
# starttls (défaut, TLS exigé) | implicit (port 465) | none (relais de confiance uniquement)
SMTP_TLS=starttls

# Microsoft Graph, avec EMAIL_PROVIDER=graph : une application inscrite dans
# Microsoft Entra, son secret client, et la boîte qui envoie. L'application n'a
# besoin que du droit Mail.Send, à limiter à cette boîte dans Exchange Online
# (voir « Email par Microsoft 365 » dans le README). Un email porte 2 Mo de
# fichiers au plus.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX=formulaires@exemple.fr

# --- Alertes Slack / Microsoft Teams / Discord ------------------------------
# Les webhooks se règlent formulaire par formulaire, dans l'interface. Seuls
# les hôtes officiels de ces services sont acceptés. Pour un service servi
# sur un autre hôte, ajoutez-le ici (séparés par des virgules ;
# « .exemple.com » couvre tous les sous-domaines). Le serveur appellera ces
# hôtes : n'y mettez que ceux dont vous répondez.
# WEBHOOK_ALLOWED_HOSTS=chat.exemple.com

# --- Marque blanche ---------------------------------------------------------
BRAND_NAME=Naria
BRAND_COMPANY=Naria
# BRAND_SUPPORT_EMAIL=contact@exemple.fr   # affiché en pied de page ; vide = masqué
BRAND_TAGLINE=Les formulaires de vos sites, sans confier vos données à un tiers.
BRAND_COLOR=#197a9c
# BRAND_COLOR_DARK=
# BRAND_LOGO_FILE=/branding/logo.webp
# BRAND_FAVICON_FILE=/branding/favicon.png
# BRAND_CSS_FILE=/branding/main.css
# Pages légales (fragments HTML) ; sans fichier, la page et son lien disparaissent.
# BRAND_PRIVACY_FILE=/branding/privacy.html
# BRAND_LEGAL_FILE=/branding/legal.html

# Longueur minimale des mots de passe à leur définition.
# PASSWORD_MIN_LENGTH=12

# Cloudflare Turnstile (anti-robot) sur la page de connexion de l'interface.
# Les deux clés ensemble ou aucune (une seule = refus au démarrage). Activé, la
# page de connexion charge un script Cloudflare ; les formulaires de vos sites
# ne sont pas concernés.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Domaine servi par Caddy (profil prod).
DOMAIN=forms.exemple.fr
# Trois premiers octets du sous-réseau docker du compose, à changer s'il
# recouvre un réseau de la machine. La passerelle y prend l'adresse .1, Caddy
# la .2.
# DOCKER_SUBNET_PREFIX=172.30.250
