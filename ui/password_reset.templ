package ui

// authShell : squelette des pages hors session (connexion, mot de passe
// oublié) : même en-tête, logo et pied que LoginPage, sans le header.
templ authShell(title string) {
	<!DOCTYPE html>
	<html lang={ Lang(ctx) } data-theme={ ThemeAttr(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - { Theme.Name }</title>
			<link rel="icon" href={ Theme.FaviconURL }/>
			<link rel="apple-touch-icon" href={ Theme.FaviconURL }/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<meta name="theme-color" content={ Theme.Color }/>
			<link rel="stylesheet" href="/static/main.css"/>
			if TurnstileSiteKey != "" {
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
			}
		</head>
		<body style={ brandVars() }>
			<main class="container auth-main">
				<div style="text-align:center;margin-bottom:28px">
					if Theme.HasLogo {
						<img src={ Theme.LogoURL } alt={ Theme.Company } style="max-height:72px;margin:0 auto"/>
					} else {
						<img src={ Theme.FaviconURL } alt={ Theme.Company } style="height:64px;margin:0 auto"/>
						<div class="brand-text" style="font-size:1.8rem;font-weight:700;color:var(--ink);margin-top:8px">{ Theme.Name }</div>
					}
				</div>
				{ children... }
				<div class="mt-18" style="display:flex;flex-direction:column;align-items:center;gap:10px">
					<div style="display:inline-flex;align-items:center;gap:12px">
						<a href={ templ.SafeURL("/theme?to=" + themeToggleTarget(ctx)) } class="theme-toggle" role="button" aria-label={ T(ctx, "theme.toggle") } title={ T(ctx, "theme.toggle") }>◐</a>
						@langSwitch()
					</div>
					@poweredBy()
				</div>
			</main>
			<script src="/static/app.js" defer></script>
		</body>
	</html>
}

// ForgotPasswordPage : demande d'un lien de réinitialisation. `sent` affiche
// la même confirmation que le compte existe ou non (pas d'énumération).
templ ForgotPasswordPage(csrf, errMsg string, sent bool) {
	@authShell(T(ctx, "forgot.title")) {
		<div class="service-card">
			<h1 style="font-size:1.5rem;text-align:center">{ T(ctx, "forgot.heading") }</h1>
			if sent {
				<p role="status" class="alert alert--success">{ T(ctx, "forgot.sent") }</p>
				<p style="text-align:center;font-size:.85rem"><a href="/login">{ T(ctx, "forgot.back") }</a></p>
			} else {
				<p class="muted" style="font-size:.9rem;margin-top:0">{ T(ctx, "forgot.help") }</p>
				if errMsg != "" {
					<p id="forgot-error" role="alert" class="alert alert--error">{ errMsg }</p>
				}
				<form method="post" action="/login/forgot">
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<label style="display:block;margin-bottom:20px">
						<span class="field-label">{ T(ctx, "login.email") }</span>
						<input type="email" name="email" required autofocus autocomplete="username" aria-describedby="forgot-error" class="input"/>
					</label>
					if TurnstileSiteKey != "" {
						<div class="cf-turnstile" data-sitekey={ TurnstileSiteKey } data-language={ Lang(ctx) }></div>
					}
					<button type="submit" class="btn btn--block">{ T(ctx, "forgot.submit") }</button>
				</form>
				<p class="mt-18" style="text-align:center;font-size:.85rem;margin-bottom:0"><a href="/login">{ T(ctx, "forgot.back") }</a></p>
			}
		</div>
	}
}

// ResetPasswordPage : choix du nouveau mot de passe depuis le lien reçu.
templ ResetPasswordPage(csrf, token, errMsg string, minLen int) {
	@authShell(T(ctx, "reset.title")) {
		<div class="service-card">
			<h1 style="font-size:1.5rem;text-align:center">{ T(ctx, "reset.heading") }</h1>
			if errMsg != "" {
				<p id="reset-error" role="alert" class="alert alert--error">{ errMsg }</p>
			}
			<form method="post" action="/login/reset">
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<input type="hidden" name="token" value={ token }/>
				<label style="display:block;margin-bottom:14px">
					<span class="field-label">{ T(ctx, "reset.password") }</span>
					<input type="password" name="password" required autofocus autocomplete="new-password" minlength={ itoa(int64(minLen)) } aria-describedby="reset-error" class="input"/>
				</label>
				<label style="display:block;margin-bottom:20px">
					<span class="field-label">{ T(ctx, "reset.confirm") }</span>
					<input type="password" name="password_confirm" required autocomplete="new-password" minlength={ itoa(int64(minLen)) } aria-describedby="reset-error" class="input"/>
				</label>
				<button type="submit" class="btn btn--block">{ T(ctx, "reset.submit") }</button>
			</form>
		</div>
	}
}

// ResetInvalidPage : lien inconnu, déjà utilisé ou expiré.
templ ResetInvalidPage() {
	@authShell(T(ctx, "reset.title")) {
		<div class="service-card">
			<h1 style="font-size:1.5rem;text-align:center">{ T(ctx, "reset.heading") }</h1>
			<p role="alert" class="alert alert--error">{ T(ctx, "reset.err.invalid") }</p>
			<p style="text-align:center;margin-bottom:0"><a href="/login/forgot" class="btn btn--ghost btn--sm">{ T(ctx, "reset.request_again") }</a></p>
		</div>
	}
}
